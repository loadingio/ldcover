doctype html
html
  head
    include @/@loadingio/bootstrap.ext/index.pug
    +css([
      {name: "bootstrap", version: "main", path: "dist/css/bootstrap.min.css"},
      {name: "@loadingio/bootstrap.ext"},
      {name: "ldloader",version: "main"},
      {name: "ldcover", version: "dev"},
      {url: "css/index.css"}
    ])
  body
    .ldcv.mini.left.bottom.right(ld="ldcv-mini"): .base: .inner.d-flex.px-3.py-2.align-items-center.bg-info.text-light
      .flex-grow-1.mr-2 By continuing to browse, you agree to our use of cookies.
      a.btn.btn-sm.btn-outline-light.mr-2(href="http://info.cern.ch") Not Agree
      .btn.btn-sm.btn-light(data-ldcv-set="") I agree

    .ldcv(ld="ldcv-timeout"): .base: .inner.p-4: .p-4
      h1 Timeout Popup
      p this is a popup that will be triggered after you open this website.
      .text-right.mt-4: .btn.btn-lg.btn-outline-secondary(data-ldcv-set="") Close

    .ldcv(ld="ldcv-hint"): .base: .inner.p-4: .p-4
      h1 Just a Hint
      p this is a hint with normal priority, which has the same priority with the timeout popup.

    template(ld="ldcv-template"): .ldcv: .base: .inner.p-4: .p-4
      h1 from template
      p This modal is created based on a template tag as root. Since browser only parses but not renders tags inside template, this can effectively reduce DOM element count, thus improve performance.
      br
      .btn.btn-primary.btn-lg(data-ldcv-set="") OK, Got it

    .ldcv(ld="ldcv-confirm"): .base.rwd: .inner.w-100.h-100.position-relative.p-4(style="padding-bottom:5em")
      .text-center: h1 Confirmed.
      br
      p We have saved your confirmation. You won't see this again until next time we update our terms and conditions.
      hr
      .btn.btn-lg.btn-primary(data-ldcv-set="") Dismiss

    .ldcv(ld="ldcv-get-value"): .base.w-640.rwd: .inner.w-100.h-100
      .d-flex.justify-content-around
        .p-4
          h2 resolve
          div: :md resolving `get` call by `data-ldcv-set` or `set` api call.
          .btn.btn-block.btn-lg.btn-outline-secondary(data-ldcv-set="ok") OK
        .p-4
          h2 reject
          div: :md rejecting `get` call by `data-ldcv-cancel` or `cancel` api call
          .btn.btn-block.btn-lg.btn-outline-secondary(data-ldcv-cancel) Cancel
      .pb-4.px-4.text-muted You can check developer console for actual output.

    .ldcv(ld="ldcv-tos"): .base.h-100.w-640.rwd: .inner.w-100.h-100.position-relative(style="padding-bottom:5em")
      .p-4.h-100(style="overflow:scroll")
        include tos.pug
      .position-absolute.w-100.p-4.bg-white.border-top(style="bottom:0;box-shadow:0 -3px 6px rgba(0,0,0,.1)")
        .d-flex
          a.btn.btn-outline-primary.mr-2.flex-grow-1(href="http://info.cern.ch") I don't agree
          .btn.btn-primary.ml-2.flex-grow-1(ld="agree") I agree

    .w-1024.rwd.mx-auto.p-4
      .mb-4
        h1.mb-0: .text-sm Dialog Gallery
        .text-muted Here we demonstrate various dialogs with different purposes and usage.

      .my-4: hr

      .mb-5
        .mb-2
          h2.mb-0: .text-sm Customized Dialog
          .text-muted these dialogs are built with customized DOM
        .d-flex.g-2.flex-wrap
          .d-inline-block
            .btn.btn-outline-primary(ld="show-editbox") Show Edit Box
            .ldcv.inline(ld="ldcv-editbox"): .base: .inner.p-2
              textarea.form-control.mb-2(rows="5")
              .btn.btn-primary(data-ldcv-set="") OK
          .btn.btn-outline-primary(ld="show-tos") Show Term of Use
          .btn.btn-outline-primary(ld="get-value") Get Value
          .btn.btn-outline-primary(ld="show-hint") Show Hint
          .btn.btn-outline-primary(ld="show-template") Show Template

      .mb-5
        .mb-2
          h2.mb-0: .text-sm Builtin Dialog
          .text-muted these dialogs are triggered with configs only. No customized DOM required.
        .d-flex.g-2.align-items-center.mb-4
          .btn.btn-outline-primary(ld="demo-alert") alert
          .btn.btn-outline-primary(ld="demo-confirm") confirm
          .btn.btn-outline-danger(ld="demo-confirm-danger") confirm ( danger )
          .btn.btn-outline-primary(ld="demo-prompt") prompt
          .btn.btn-outline-primary(ld="demo-dialog") dialog
          //- sets the global default via ldcover.dialog.theme(...)
          select.form-control.ml-3(ld="demo-theme", style="width:auto")
            option(value="default", selected) theme: default
            option(value="bootstrap") theme: bootstrap
            option(value="generic") theme: generic
        div(style="max-width:32em")
          .text-muted.mb-2 Try also customized title / description then trigger a dialog:
          .d-flex.g-2
            div(style="flex:2 0 30%"): input.form-control.mb-2(ld="dlg-title", placeholder="title ( optional )")
            div(style="flex:1 0 30%")
              select.form-control.mb-2(ld="dlg-theme")
                option(value="bootstrap", selected) theme: bootstrap
                option(value="default") theme: default
                option(value="generic") theme: generic ( unstyled )
          textarea.form-control.mb-2(ld="dlg-msg", rows="3", placeholder="description / message")
          .text-right
            .btn.btn-outline-primary.mr-2(ld="test-alert") alert
            .btn.btn-outline-primary(ld="test-confirm") confirm

    +script([
      {name: "ldview"},
      {name: "ldloader"},
      {name: "@loadingio/ldquery"},
      {name: "@loadingio/debounce.js"},
      {name: "ldcover", version: "dev"},
      {name: "zmgr"},
      "js/index.js"
    ])
